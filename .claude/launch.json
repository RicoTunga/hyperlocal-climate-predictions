{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-dev",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "web.server"],
      "port": 8766,
      "env": { "HL_PORT": "8766", "HL_AUTH_DB": "data/auth/dev_test.db" }
    },
    {
      "name": "dashboard-live",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "web.server"],
      "port": 8765,
      "env": { "HL_PORT": "8765", "HL_LIVE": "1" }
    }
  ]
}
