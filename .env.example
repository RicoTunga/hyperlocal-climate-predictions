# Copy to .env and fill in. .env is git-ignored.
# CDS API credentials normally live in ~/.cdsapirc (outside the repo).
GEE_PROJECT=your-google-cloud-project-id
TAHMO_API_USER=
TAHMO_API_PASSWORD=

# Dashboard server (python -m web.server). Defaults suit the laptop; see deploy/README.md for hosting.
# HL_HOST=127.0.0.1
# HL_PORT=8765
# HL_AUTH_DB=data/auth/users.db
# HL_SECURE_COOKIES=0      # set to 1 only when the site is served over HTTPS
