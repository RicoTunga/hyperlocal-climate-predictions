# Data and artefacts (re-create with the ingestion scripts)
data/raw/*
data/processed/*
models/*
!**/.gitkeep

# Secrets - never commit
.env
*.json.key
credentials*.json
.cdsapirc

# Python / Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.pytest_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# CatBoost training logs
catboost_info/

# Dashboard data (rebuilt by python -m app.build_data)
app/data/

# Playwright browsers and dashboard screenshots (dev only)
.playwright/
web/screenshots/

# Dashboard accounts and sessions (password hashes): never commit
data/auth/
*.db
